{
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python D:/SVRPTW/.claude/hooks/obsidian_log.py"
          },
          {
            "type": "command",
            "command": "python -c \"from graphify.watch import _rebuild_code; from pathlib import Path; _rebuild_code(Path('D:/SVRPTW'))\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python D:/SVRPTW/.claude/hooks/context_guard.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python D:/SVRPTW/.claude/hooks/session_briefing.py"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python*)",
      "Bash(git*)",
      "Bash(ls*)",
      "Bash(find*)",
      "Bash(mkdir*)",
      "Bash(cp*)",
      "Bash(mv*)",
      "Bash(wsl*)",
      "PowerShell(*)"
    ]
  }
}
